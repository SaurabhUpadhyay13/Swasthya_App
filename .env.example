# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Free key from https://build.nvidia.com (sign in, open any model, "Get API Key"). Starts with nvapi-
# Only needed for POST /summarize
NVIDIA_API_KEY=

# Any chat model with a "Free Endpoint" badge on https://build.nvidia.com/models
NVIDIA_MODEL=openai/gpt-oss-20b

# Rough minutes per consultation, used for the "estimated wait" shown to patients
AVG_CONSULT_MINUTES=10

# Add sample patients and orders on the FIRST start only, when the databases are empty.
# Keep this false for real data: demo rows would end up in your analysis.
SEED_DEMO_DATA=false

# Where the two database files (opd.db, supply_chain.db) are kept. Default: ./data
# DATA_DIR=data
